edited
-- no --
n
-- yes --
yes
-- plugin --
#!/bin/sh
if [ "$1" = meta ]; then
 echo '{"protocol":1,"id":"demo","languages":[],"manifests":[],"default_on":false,"config_schema":{}}'
else
 echo '{"files":[],"stale":[],"links":[],"warnings":["sample warning"]}'
fi

-- broken --
broken git record

