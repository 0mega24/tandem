# Discover the real Zig example from the XDG user directory.
mkdir $XDG_DATA_HOME/tandem/plugins
cp $PLUGIN_EXAMPLES/tdm-gen-zig $XDG_DATA_HOME/tandem/plugins/tdm-gen-zig
exec chmod +x $XDG_DATA_HOME/tandem/plugins/tdm-gen-zig
exec tdm generate --list
stdout 'SOURCE'
stdout '^go +on +Go +go.mod +built-in$'
stdout '^zig +off +Zig +build.zig.zon +.*/tdm-gen-zig$'

exec tdm plugin check zig
stdout 'zig: meta passed'
stdout 'zig: plan passed'

mkrepo app lib
exec tdm new feat app lib --generate zig
cp manifest $HOME/workspaces/feat/app/build.zig.zon
cp manifest $HOME/workspaces/feat/lib/build.zig.zon
exec tdm generate feat
stdout 'zig +✓ .tandem/zig/forks.args'
cmp $HOME/workspaces/feat/.tandem/zig/forks.args forks.args

# Config IDs are checked after plugins have registered.
exec tdm --config plugins.toml generate --list
stdout '^zig +off +Zig +build.zig.zon +.*/tdm-gen-zig$'

# A failed plugin plan rolls back the worktree creation.
cp failed $XDG_DATA_HOME/tandem/plugins/tdm-gen-fail
exec chmod +x $XDG_DATA_HOME/tandem/plugins/tdm-gen-fail
! exec tdm new broken app lib --generate fail
stderr 'fail: plan failed'
stderr 'supported versions: 1'
! exists $HOME/workspaces/broken

# A plugin with a built-in ID is a warning, so it does not block other commands; the built-in stays.
cp collision $XDG_DATA_HOME/tandem/plugins/tdm-gen-go
exec chmod +x $XDG_DATA_HOME/tandem/plugins/tdm-gen-go
exec tdm generate --list
stderr '^tdm: warning: plugin .*tdm-gen-go: the ID "go" is a built-in generator'
stdout '^go +on +Go +go.mod +built-in$'
! stderr 'panic'

# A command that needs no generator runs no plugin: meta waits until a command needs it.
cp marker $XDG_DATA_HOME/tandem/plugins/tdm-gen-marker
exec chmod +x $XDG_DATA_HOME/tandem/plugins/tdm-gen-marker
exec tdm status feat
exec tdm path feat
! exists $WORK/meta-ran
exec tdm generate --list
exists $WORK/meta-ran

-- marker --
#!/bin/sh
touch "$WORK/meta-ran"
echo '{"protocol":1,"id":"marker","languages":[],"manifests":[],"default_on":false,"config_schema":{}}'
-- manifest --
.{}
-- forks.args --
--fork=../../app
--fork=../../lib
-- collision --
#!/bin/sh
printf '%s\n' '{"protocol":1,"id":"go","languages":[],"manifests":[],"default_on":false,"config_schema":{}}'
-- plugins.toml --
[generate]
enabled = ["zig"]
[generate.zig]
custom_setting = true
-- failed --
#!/bin/sh
if [ "$1" = meta ]; then
    printf '%s\n' '{"protocol":1,"id":"fail","languages":[],"manifests":[],"default_on":false,"config_schema":{}}'
else
    echo 'plan failed' >&2
    exit 1
fi
