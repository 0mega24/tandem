# generate writes go.work for the Go members, and deletes the stale go.work.sum when it writes.
mkrepo api lib web
exec tdm new feat api lib web
cp api.mod $HOME/workspaces/feat/api/go.mod
cp lib.mod $HOME/workspaces/feat/lib/go.mod
cp sum $HOME/workspaces/feat/go.work.sum

exec tdm generate feat
stdout '^  go +✓ go.work +\(api, lib\)$'
cmp $HOME/workspaces/feat/go.work two.work
! exists $HOME/workspaces/feat/go.work.sum

# The same plan writes nothing.
exec tdm generate feat
stdout '^  go += go.work +unchanged$'

# A dry run changes nothing, also in the state.
rm $HOME/workspaces/feat/lib/go.mod
exec tdm generate --dry-run feat
stdout '^  go +✓ go.work +\(api\)$'
stdout '^dry run: nothing was written$'
stdout '^-\t\./lib$'
stdout '^--- go.work$'
cmp $HOME/workspaces/feat/go.work two.work
cp $HOME/.local/share/tandem/spaces/feat.yaml before.yaml
mv $HOME/workspaces/feat/go.work saved.work
exec tdm generate --dry-run --force feat
stderr 'generated file go.work is gone'
cmp $HOME/.local/share/tandem/spaces/feat.yaml before.yaml
mv saved.work $HOME/workspaces/feat/go.work

# A file that a person changed is skipped; --force replaces it and keeps a copy.
cp edited.work $HOME/workspaces/feat/go.work
exec tdm generate feat
stdout '! go.work +skipped: changed by a person; --force replaces it and keeps a copy'
cmp $HOME/workspaces/feat/go.work edited.work
exec tdm generate --force feat
stdout '✓ go.work +\(api\) +changed by a person; the old file is in go.work.tandem-bak'
cmp $HOME/workspaces/feat/go.work one.work
cmp $HOME/workspaces/feat/go.work.tandem-bak edited.work

# With no Go member left, tdm deletes its go.work.
rm $HOME/workspaces/feat/api/go.mod
exec tdm generate feat
stdout '^  go +- go.work +deleted$'
! exists $HOME/workspaces/feat/go.work

# A file that someone else wrote is not tdm's.
cp api.mod $HOME/workspaces/feat/api/go.mod
cp edited.work $HOME/workspaces/feat/go.work
exec tdm generate feat
stdout 'skipped: not written by tdm'
cmp $HOME/workspaces/feat/go.work edited.work

# The space keeps the generator set; a file that is gone leaves the state with a warning.
rm $HOME/workspaces/feat/go.work.tandem-bak
exec tdm generate --force feat
rm $HOME/workspaces/feat/go.work
exec tdm status feat
stderr 'warning: go: generated file go.work is gone, so it left the state of space feat'

exec tdm generate --list
stdout '^go +on +Go +go.mod +built-in$'

! exec tdm generate --list feat
stderr '--list takes no space'
! exec tdm generate
stderr 'usage: tdm generate <space>'

-- api.mod --
module example.com/api

go 1.23
-- lib.mod --
module example.com/lib

go 1.22
-- sum --
x
-- edited.work --
go 1.23

use ./api
-- two.work --
// Generated by tandem for space feat. Do not edit. Run 'tdm generate feat' to update.

go 1.23

use (
	./api
	./lib
)
-- one.work --
// Generated by tandem for space feat. Do not edit. Run 'tdm generate feat' to update.

go 1.23

use (
	./api
)
