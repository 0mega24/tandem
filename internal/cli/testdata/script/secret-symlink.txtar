# A secret is never written through a symlink: an existing branch can track .env as a link to a
# file outside the worktree, and the copy must not change that file.
mkrepo api
exec git -C $HOME/repos/api checkout -q -b feat
symlink $HOME/repos/api/.env -> $WORK/outside.txt
exec git -C $HOME/repos/api add .env
exec git -C $HOME/repos/api commit -q -m 'link .env'
exec git -C $HOME/repos/api checkout -q main
cp secret.txt $HOME/repos/api/.env
mkdir $HOME/.config/tandem
cp config.toml $HOME/.config/tandem/config.toml

exec tdm new feat api
cmp $WORK/outside.txt outside-before.txt
stderr 'warning: api: .env is a symlink in the worktree, so the secret is not copied'

-- outside.txt --
not a secret
-- outside-before.txt --
not a secret
-- secret.txt --
KEY=1
-- config.toml --
[always]
secrets = [".env"]
