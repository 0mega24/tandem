# Look of every recording: the owner's terminal colors and font, no window bar.
Set Shell "zsh"
# CSS needs the quotes around the family: the name starts with a digit.
Set FontFamily `"0xProto Nerd Font Mono", monospace`
Set FontSize 18
Set LineHeight 1.25
Set Padding 24
Set TypingSpeed 45ms
Set Theme { "name": "tandem", "background": "#1e2021", "foreground": "#e4dfe9", "cursor": "#e4dfe9", "selection": "#5e7990", "black": "#425c72", "red": "#9e6160", "green": "#bb6b53", "yellow": "#d56854", "blue": "#516d84", "magenta": "#816872", "cyan": "#69687a", "white": "#d97752", "brightBlack": "#5e7990", "brightRed": "#be7e7d", "brightGreen": "#dd8970", "brightYellow": "#f88772", "brightBlue": "#6e8aa2", "brightMagenta": "#a08590", "brightCyan": "#878598", "brightWhite": "#fc9671" }
