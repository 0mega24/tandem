#!/usr/bin/env python3
"""Plan Bundler local override variables; do not write member files."""
import json
import os
import shlex
import sys

if sys.argv[1:] == ["meta"]:
    answer = {"protocol": 1, "id": "bundler", "languages": ["Ruby"],
              "manifests": ["*.gemspec"], "default_on": False,
              "config_schema": {"type": "object", "properties": {}}}
elif sys.argv[1:] == ["plan"]:
    request = json.load(sys.stdin)
    lines = ["# Generated by tandem. Source this file before bundle.\n"]
    for member in request["members"]:
        worktree = member["worktree"]
        for name in sorted(os.listdir(worktree)):
            if name.endswith(".gemspec"):
                gem = name[:-8].upper().replace("-", "___").replace(".", "__")
                if not gem or not all(c.isascii() and (c.isalnum() or c == "_") for c in gem):
                    raise ValueError("gemspec name cannot form a Bundler environment key")
                lines.append("export BUNDLE_LOCAL__" + gem + "=" + shlex.quote(worktree) + "\n")
    answer = {"files": [{"path": ".tandem/bundler/env", "content": "".join(lines)}] if len(lines) > 1 else [],
              "stale": [], "links": [], "warnings": []}
else:
    sys.exit("usage: tdm-gen-bundler meta|plan")
json.dump(answer, sys.stdout)
print()
